[Unit]
Description=onmaeum board server
After=network-online.target
Wants=network-online.target

[Service]
User=orangepi
WorkingDirectory=/home/orangepi/mosieung/edge-server
Environment=ONMAEUM_STT_WHISPER=/home/orangepi/mosieung/stt/small-v3
Environment=ONMAEUM_LLM_PATH=/home/orangepi/mosieung/mosieung-escalator_w8a8_opt1_cal500.rkllm
Environment=ONMAEUM_TTS=1
Environment=ONMAEUM_TTS_DIR=/home/orangepi/mosieung/tts/vits-mimic3-ko_KO-kss_low
ExecStart=/home/orangepi/mosieung/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
